# ARC Tower configuration. `python start.py setup` copies this to .env and fills the secrets.

# --- ARC Tower app -----------------------------------------------------------
ARC_PORT=8000
ARC_BASE_URL=http://localhost:8000
ARC_SECRET_KEY=
ARC_SESSION_SECRET=
ARC_ADMIN_EMAIL=admin@arc.local
ARC_ADMIN_PASSWORD=
# SQLite for the PoC. For production point this at Postgres, e.g.
# postgresql+psycopg://arc:pass@db-host:5432/arc
ARC_DATABASE_URL=

# --- Ingest proxy (the OTLP endpoint clients point at) -----------------------
# 127.0.0.1 = only this machine can send. Use 0.0.0.0 to accept agents from other machines.
PROXY_HOST=127.0.0.1
PROXY_PORT=4318
# The URL shown to clients in their env block.
ARC_PUBLIC_INGEST_URL=http://localhost:4318/otlp

# --- Langfuse (trace store) --------------------------------------------------
# Langfuse Cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US),
# or the URL of a self-hosted Langfuse. Leave keys empty to run without Langfuse.
LANGFUSE_HOST=https://cloud.langfuse.com
# Shared project: every product's traces go here, tagged tenant:<slug> / product:<slug>.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional, Langfuse Enterprise only: organization-scoped keys let ARC create one
# Langfuse project per product automatically.
LANGFUSE_ORG_PUBLIC_KEY=
LANGFUSE_ORG_SECRET_KEY=

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Secrets store -----------------------------------------------------------
# "local" = encrypted in the ARC database with ARC_SECRET_KEY. "vault" = HashiCorp Vault KV v2.
ARC_SECRETS_BACKEND=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret

# --- Single sign-on (optional, OIDC e.g. Entra ID) ---------------------------
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Model prices (USD per 1M tokens, [input, output]). Used by the dashboards' cost panels
# AND stamped onto every model-call span as its Langfuse cost at ingest, so clients never
# need to register prices in Langfuse. Dated snapshots (gpt-4.1-2025-04-14) match their base name.
ARC_MODEL_PRICES={"gpt-4o":[2.5,10],"gpt-4o-mini":[0.15,0.6],"gpt-4.1":[2,8],"gpt-4.1-mini":[0.4,1.6],"claude-sonnet-4":[3,15],"claude-haiku-4-5":[1,5],"anthropic.claude-3-haiku":[0.25,1.25],"amazon.nova-lite":[0.06,0.24],"text-embedding-3-large":[0.13,0],"text-embedding-3-small":[0.02,0]}
