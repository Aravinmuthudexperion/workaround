# Prometheus - ARC Tower KPI store. Rendered by `arc_tower.infra.render`.
# Metrics arrive over OTLP from the collector (--web.enable-otlp-receiver);
# intelligence-job metrics are scraped.

global:
  scrape_interval: 15s
  evaluation_interval: 15s

otlp:
  keep_identifying_resource_attributes: true
  promote_resource_attributes: [deployment.environment]

storage:
  tsdb:
    out_of_order_time_window: 30m

scrape_configs:
  - job_name: arc-intelligence
    honor_labels: true
    static_configs:
      - targets: ["127.0.0.1:{{ ports.intelligence }}"]
