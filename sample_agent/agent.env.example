# The ONLY ARC Tower-specific configuration a client app needs.
# Copy the block ARC Tower shows in onboarding step 2 (it contains your ingest key).

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=x-arc-key=<your ingest key>
OTEL_SERVICE_NAME=claims-assistant
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,service.version=1.4.0
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
